# Copy this file to .env and fill in real values. Never commit .env.

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Local Postgres example — adjust user/password/host/db name to match your setup
DATABASE_URL=postgresql://gibyt_user:gibyt_password@localhost:5432/gibyt

# "development" or "production" — controls secure-cookie behavior
FLASK_ENV=development
